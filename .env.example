# Configuração do Firebase Web Client
VITE_FIREBASE_API_KEY=sua-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=arena-voice-voto-popular.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=arena-voice-voto-popular
VITE_FIREBASE_STORAGE_BUCKET=arena-voice-voto-popular.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890

# Configuração de Emuladores Locais (opcional para desenvolvimento offline)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

