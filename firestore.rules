rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. NEGAÇÃO PADRÃO (Deny by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // Funções utilitárias de verificação de autenticação e claims do servidor
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superadmin'
      );
    }

    // 2. COLEÇÃO: events
    // Leitura: pública se evento ativo ou finalizado; se rascunho apenas admin
    // Escrita: restrita estritamente a administradores validados
    match /events/{eventId} {
      allow read: if resource.data.status in ['active', 'finished'] || isAdmin();
      allow write: if isAdmin();
    }

    // 3. COLEÇÃO: projects
    // Leitura: pública se o projeto estiver ativo na competição ou se for admin
    // Escrita: restrita estritamente a administradores validados
    match /projects/{projectId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // 4. COLEÇÃO: rounds
    // Leitura: pública para acompanhar o status e o projeto em avaliação em tempo real
    // Escrita direta pelo cliente: proibida (abertura e encerramento operados por Cloud Functions)
    match /rounds/{roundId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. COLEÇÃO: votes
    // Escrita direta pelo cliente: PROIBIDA (votos são validados e registrados exclusivamente via Cloud Function 'submitVote')
    // Leitura: cada eleitor anônimo só tem acesso para consultar seu próprio voto
    match /votes/{voteId} {
      allow read: if isAuthenticated() && (resource.data.voterUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 6. COLEÇÃO: results
    // Leitura: pública para telão e painéis quando os resultados estiverem ativos
    // Escrita direta pelo cliente: PROIBIDA (cálculos matemáticos e agregações processados atomicamente pelo backend)
    match /results/{resultId} {
      allow read: if true;
      allow write: if false;
    }

    // 7. COLEÇÃO: admins
    // Protege metadados administrativos e registros da equipe
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
